{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Rethinkify",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}/dd.ps1",
                "build",
                "debug"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "detail": "Debug CMake + Ninja build via pinned dd"
        },
        {
            "label": "Build Rethinkify (Release)",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}/dd.ps1",
                "build",
                "release"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": "$msCompile",
            "detail": "Release CMake + Ninja build via pinned dd"
        },
        {
            "label": "Test Rethinkify",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}/dd.ps1",
                "test",
                "--label",
                "unit"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "detail": "Build and run unit tests in Debug and Release without GUI smoke tests"
        }
    ]
}
